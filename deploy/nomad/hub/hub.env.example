# Brokkr HUB env contract for the Nomad Variable. Populate, then from hub/:
#   grep -vE '^\s*(#|$)' hub.env.example | xargs nomad var put -force nomad/jobs/brokkr-hub
#
# WARNING: sim/trial posture - LOCAL_SIMULATION_ENABLED bypasses authentication;
# never expose the hub or the Redis bus to an untrusted network.
#
# Same keys as deploy/docker-compose/hub/.env.example (the authoritative,
# fully-commented surface). Every key must be PRESENT - empty values are fine.
# The image and published ports are job vars (see brokkr-hub.nomadvars).

# ---- core ----
HH_ENV=dev
# Must NOT be "production": sim mode is refused there (hard kill-switch), and
# the static SPA only serves under production - use the REST API in this mode.
NODE_ENV=development
IS_LOCAL=true
LOG_LEVEL=debug
LOCAL_SIMULATION_ENABLED=true
VITE_LOCAL_SIMULATION_ENABLED=true

BASE_URL=http://localhost:3000

BETTER_AUTH_SECRET=local-sim-dev-better-auth-secret-do-not-use-anywhere-real
DEVICE_TOKEN_PEPPER=local-sim-dev-device-token-pepper-do-not-use-anywhere-real
HYDRAHOST_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Datastores - the bundled sidecars share the alloc network namespace, so
# 127.0.0.1. Point at your own endpoints when bundled_datastores = false.
DATABASE_URL=postgresql://thor:password@127.0.0.1:5432/thor
PGBOUNCER_CONNECTION_STRING=postgresql://thor:password@127.0.0.1:5432/thor
PG_TOKEN=
REDIS_URL=redis://127.0.0.1:6379
# Path to a CA file, used only for rediss:// URLs.
REDIS_CA_CERT=

# Inert placeholders - no Vault runs in this posture and it is never contacted;
# Vault-only features (provisioning, phone-home, commissioning) are unavailable.
VAULT_ADDR=http://localhost:8200
VAULT_APP_ROLE_ID=unused
VAULT_SECRET_ID=unused
VAULT_SKIP_VERIFY=true

# Sim-only toggles.
ENABLE_BRIDGE_API_MTLS=false
KAFKA_ENABLED=false
HEARTBEAT_MONITOR_ENABLED=false
# DANGER: disables TLS verification for ALL outbound Node HTTPS. Sim default;
# set 1 if anything talks to real TLS endpoints.
NODE_TLS_REJECT_UNAUTHORIZED=0
NOMAD_ADDR=

# Browser-safe SPA keys (entrypoint writes these into env-config.js).
STRIPE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=
RADAR_PUBLISHABLE_KEY=

# Non-empty on purpose: analytics wraps the host as https://HOST:8443 and the
# clickhouse client rejects an empty host.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Non-empty on purpose: svix validates the whsec_<base64> format at boot.
OPENMETER_WEBHOOK_SECRET=whsec_cGxhY2Vob2xkZXItbm90LWZvci1yZWFsLXVzZQ==
OPENMETER_API_KEY=

# ---- optional integrations: keep present, leave empty to disable ----
AIVEN_THANOS_BASE_URL=
AIVEN_THANOS_USERNAME=
AIVEN_THANOS_PASSWORD=
GRAVWELL_BASE_URL=
GRAVWELL_API_TOKEN=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CONTACT_OWNER_ID=
HUBSPOT_FORM_ID_DEMAND_REQUEST=
HUBSPOT_DEMAND_REQUEST_OBJECT_TYPE_ID=
HUBSPOT_PORTAL_ID=
HYPERVISOR_ROLE_ID=
HYPERVISOR_DEVICE_TYPE_ID=
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_SERVICE_URI=
KAFKA_PASSWORD=
KAFKA_ACCESS_KEY=
KAFKA_ACCESS_CERT=
KAFKA_CA_CERT=
KAFKA_LOG_TOPIC=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
MAILGUN_API_KEY=
MAILGUN_API_URL=
RESEND_API_KEY=
NETBOX_API_TOKEN=
NETBOX_API_URL=
PYLON_ACCOUNT_ID=
PYLON_API_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
STRIPE_API_SECRET=
STRIPE_PMC_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ACCOUNT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
SENTRY_AUTH_TOKEN=
SF_COMPUTE_API_KEY=
