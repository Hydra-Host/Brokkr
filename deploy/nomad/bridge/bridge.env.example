# Brokkr BRIDGE env contract for the Nomad Variable. Populate, then from bridge/:
#   grep -vE '^\s*(#|$)' bridge.env.example | xargs nomad var put -force nomad/jobs/brokkr-bridge
#
# Same keys as deploy/docker-compose/bridge/.env.example. The image and the
# HTTP port are job vars (see brokkr-bridge.nomadvars).

# Point this at the HUB's Redis (the job publishes it on the hub node at
# redis_port). For a real link across networks, prefer rediss:// + a password.
REDIS_URL=redis://HUB_HOST:6379

# Zone UUID for THIS site - the bridge's Redis namespace (REDIS_PREFIX is
# derived from it); must match a Zone created in the hub.
BROKKR_ZONE_ID=00000000-0000-0000-0000-111111111111

# REQUIRED. At-rest key for device secrets: openssl rand -base64 32. The bridge
# fails closed if unset/invalid; rotating it orphans stored secrets.
BRIDGE_AT_REST_KEY=CHANGE_ME_run_openssl_rand_base64_32

# URL advertised to devices (iPXE + phone-home) - must be reachable FROM the
# devices, e.g. the node's device-facing http://192.168.200.1:8000. Keep the
# port in sync with the bridge_port job var.
BRIDGE_URL=https://brokkr.lan

# "true" pulls discovery images so real metal can PXE-boot/provision - then
# also set DISCOVERY_BASE_URL / OS_LAYER_URL / BROKKR_LIVE_VERSION below
# (the built-in defaults are non-resolving placeholders).
BRIDGE_SYNC_ENABLED=false
# DISCOVERY_BASE_URL=https://assets.example.com/brokkr-live
# OS_LAYER_URL=https://assets.example.com/os-layers/blobs
# BROKKR_LIVE_VERSION=1.0.4

# DHCP, DNS, and VRRP are configured entirely from the hub via config atoms -
# no bridge-side env. Optional runtime knobs (defaults shown):
# DHCP_LEADER_POLL_MS=2000
# DHCP_PRUNE_INTERVAL_MS=60000
# DHCP_DECLINE_BACKOFF_SECONDS=600
# DHCP_LEASE_PERSISTENCE=redis
