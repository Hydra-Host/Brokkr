# Brokkr BRIDGE environment. Copy to .env:  cp .env.example .env
# This runs on a SITE machine; it only needs to reach the hub's Redis bus.

# ---- image (published to Docker Hub at release; override with your own registry for a private build) ----
BROKKR_BRIDGE_IMAGE=hydrahost/brokkr-bridge:latest

# ---- connection to the hub ----
# Point this at the HUB machine's Redis. On the same machine as the hub for a
# local trial, use the host's reachable address (e.g. host.docker.internal on
# Docker Desktop, or the host LAN IP). For a real link across machines, prefer
# rediss:// + a password.
REDIS_URL=redis://HUB_HOST:6379

# Set the interval for delayed BullMQ job promotion.
# DELAYED_PROMOTE_INTERVAL_SECONDS=3
# Set the delay before the first Brokkr Live readiness check.
# BROKKR_LIVE_INITIAL_DELAY_SECONDS=90
# Set the maximum Brokkr Live readiness wait.
# BROKKR_LIVE_WAIT_SECONDS=1800

# Zone UUID for THIS site - the bridge's Redis namespace (REDIS_PREFIX); must
# match a Zone created in the hub. One bridge deployment per zone.
BROKKR_ZONE_ID=00000000-0000-0000-0000-111111111111

# At-rest encryption key for device secrets (AES-256, base64 32 bytes). REQUIRED, and it
# must be your OWN freshly generated key -- do NOT ship the placeholder below to a real
# bridge (anyone with a committed key can decrypt this bridge's stored device secrets). The
# bridge fails closed if it's unset/invalid. Keep it stable; rotating it orphans stored
# secrets. Generate with:
#   openssl rand -base64 32
BRIDGE_AT_REST_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Base URL the bridge advertises to devices in iPXE chain scripts + phone-home. Must be
# reachable FROM the devices, not the bridge's loopback: compose.yaml defaults it to
# https://brokkr.lan (a real LAN with DNS), but a same-machine trial/sim has no DNS for that,
# so set it to the host's device-facing address. Leave commented to keep the compose default.
# BRIDGE_URL=http://192.168.200.1:8000
#
# NOTE: only the bridge HTTP port (:8000) is published. Device-agent gRPC (:9082) is not,
# so full provisioning needs host networking or your own gRPC wiring — see compose.yaml.
#
# HTTP port the bridge binds AND publishes (the healthcheck follows it too).
# Override to run next to another stack; keep BRIDGE_URL's port in sync.
# BRIDGE_PORT=8000

# Discovery-image sync: false keeps the bridge self-contained (no external
# fetch); true pulls discovery images from the asset CDN so the bridge can
# PXE-boot/provision real metal (adds an external dependency). When you set this
# true you must also point the bridge at your asset host — uncomment and set
# DISCOVERY_BASE_URL / OS_LAYER_URL / BROKKR_LIVE_VERSION in compose.yaml (the
# built-in defaults are non-resolving *.example.com placeholders).
BRIDGE_SYNC_ENABLED=false

# ---- DHCP ----
# DHCP, DNS, and VRRP are configured entirely from the hub via config atoms — there are no
# bridge-side env vars for them. Configure subnets, DNS, VIPs, and runtime tuning in the hub UI.
