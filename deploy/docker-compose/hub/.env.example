# Brokkr HUB environment. Copy to .env:  cp .env.example .env
#
# WARNING: sim/trial posture — LOCAL_SIMULATION_ENABLED bypasses authentication, so anyone
# who can reach :3000 has full access (and Redis :6379 is published unauthenticated for the
# cross-host bridge bus). Never expose this stack to an untrusted network.
# Recipe proven by brokkr-local: integrations are empty (local-simulation mode
# disables their use). Every key is PRESENT - the app's getOrThrow() only fails
# on an UNDEFINED key, so empty strings are fine. Two exceptions are non-empty
# on purpose (CLICKHOUSE_HOST, OPENMETER_WEBHOOK_SECRET) - see the notes below.
#
# Some integration keys below (MAILGUN_*, HUBSPOT_*, SALESFORCE_*, GOOGLE_MAPS_*, RADAR_*) are read
# by first-party plugins that are NOT part of this distribution, so setting them has no effect unless
# you supply an equivalent plugin. Email falls back to SMTP via nodemailer, which is the default.

# ---- image (published to Docker Hub at release; override with your own registry for a private build) ----
BROKKR_APP_IMAGE=hydrahost/brokkr-hub:latest

# ---- core ----
HH_ENV=dev
# NODE_ENV must NOT be "production": LOCAL_SIMULATION_ENABLED (auth bypass + sim hub)
# is refused when NODE_ENV=production (hard kill-switch in
# apps/api/src/common/local-simulation.ts). Trade-off: the Nest static-SPA server is
# gated on NODE_ENV=production, so the web UI is not served in this mode — exercise the
# stack via the REST API directly, or run the Vite dev server separately against it.
NODE_ENV=development
IS_LOCAL=true
LOG_LEVEL=debug
LOCAL_SIMULATION_ENABLED=true
# LOCAL_SIMULATION_ENABLED is honored only while HH_ENV is in AUTH_BYPASS_ALLOWED_ENVS,
# which the app defaults to "dev" — matching HH_ENV above, so no assignment is needed.
# To opt extra envs in: AUTH_BYPASS_ALLOWED_ENVS=dev,ci
VITE_LOCAL_SIMULATION_ENABLED=true

BASE_URL=http://localhost:3000

# Published HOST ports (container-internal ports are fixed). If you change
# HUB_HOST_PORT, update BASE_URL to match.
# HUB_HOST_PORT=3000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

BETTER_AUTH_SECRET=local-sim-dev-better-auth-secret-do-not-use-anywhere-real
DEVICE_TOKEN_PEPPER=local-sim-dev-device-token-pepper-do-not-use-anywhere-real
HYDRAHOST_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Datastores - compose service names (postgres/redis), not localhost.
DATABASE_URL=postgresql://thor:password@postgres:5432/thor
PGBOUNCER_CONNECTION_STRING=postgresql://thor:password@postgres:5432/thor
PG_TOKEN=
REDIS_URL=redis://redis:6379
# Path to a CA file (mount it into the container), used only for rediss:// URLs.
REDIS_CA_CERT=

# No Vault server runs in this stack. These are inert placeholders so the app
# boots (VaultClient reads VAULT_ADDR/HH_ENV at construction) - Vault is never
# contacted during boot, login, or browsing. Vault-only features (provisioning,
# phone-home, nomad bridge deploy, device commissioning) are unavailable here.
VAULT_ADDR=http://localhost:8200
VAULT_APP_ROLE_ID=unused
VAULT_SECRET_ID=unused
VAULT_SKIP_VERIFY=true

# Sim-only toggles.
ENABLE_BRIDGE_API_MTLS=false
KAFKA_ENABLED=false
HEARTBEAT_MONITOR_ENABLED=false
NODE_TLS_REJECT_UNAUTHORIZED=0
NOMAD_ADDR=

# Browser-safe SPA keys (entrypoint writes these into env-config.js).
STRIPE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=
RADAR_PUBLISHABLE_KEY=

# Non-empty on purpose: analytics wraps the host as https://HOST:8443 and the
# clickhouse client rejects an empty host.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Non-empty on purpose: svix validates the whsec_<base64> format at boot.
OPENMETER_WEBHOOK_SECRET=whsec_cGxhY2Vob2xkZXItbm90LWZvci1yZWFsLXVzZQ==
OPENMETER_API_KEY=

# ---- optional integrations: keep present, leave empty to disable ----
AIVEN_THANOS_BASE_URL=
AIVEN_THANOS_USERNAME=
AIVEN_THANOS_PASSWORD=
GRAVWELL_BASE_URL=
GRAVWELL_API_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_URL=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CONTACT_OWNER_ID=
HUBSPOT_FORM_ID_DEMAND_REQUEST=
HUBSPOT_DEMAND_REQUEST_OBJECT_TYPE_ID=
HUBSPOT_PORTAL_ID=
HYPERVISOR_ROLE_ID=
HYPERVISOR_DEVICE_TYPE_ID=
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_SERVICE_URI=
KAFKA_PASSWORD=
KAFKA_ACCESS_KEY=
KAFKA_ACCESS_CERT=
KAFKA_CA_CERT=
KAFKA_LOG_TOPIC=
# Outbound email. EMAIL_PROVIDER defaults to nodemailer, so these SMTP_* keys are the transport
# this distribution actually ships; the MAILGUN_* keys below need the email-mailgun plugin.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
MAILGUN_API_KEY=
MAILGUN_API_URL=
RESEND_API_KEY=
NETBOX_API_TOKEN=
NETBOX_API_URL=
PYLON_ACCOUNT_ID=
PYLON_API_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
STRIPE_API_SECRET=
STRIPE_PMC_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ACCOUNT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
SENTRY_AUTH_TOKEN=
SF_COMPUTE_API_KEY=
