# Sample devenv.local.nix — copy it to devenv.local.nix (gitignored, auto-imported by devenv)
# and uncomment the blocks you want. Every block below is commented out, so a straight copy
# leaves `task up` byte-identical to the committed default.
#
# This is an ordinary devenv module: any option devenv.nix or devenv/modules/*.nix declares can
# be set here at plain priority, which outranks the committed defaults (they are mkDefault).
#
#   SECRETSPEC_REASON=<why> devenv eval knobCatalog     every catalogued knob: type, default, group
#   SECRETSPEC_REASON=<why> devenv eval knobProvenance  which file each effective value came from
#
# For a ONE-RUN change, do not edit this file — export an environment pin instead. Any catalogued
# knob takes BROKKR_CFG_<dotted path, each `.` written as `__>`; the nine knobs in
# devenv/env-pin-aliases.txt also answer to a BROKKR_PIN_<shorthand>. Both render a gitignored
# env.local.nix that outranks this file (mkOverride 60), and BROKKR_ENV_PINS=off skips the render
# for one run:
#
#   BROKKR_PIN_HUB_LOG_LEVEL=warn task up
#   BROKKR_CFG_ports__postgres=15432 task up
#   BROKKR_CFG_stackDefaults__hub__AUTH_BYPASS_ENABLED=false task up
#
# stack.slot and identity.pg.password refuse a pin (the slot is claimed by the stack registry, the
# password is a secret) — set those here or through the control center.
{ ... }:

{
  ## Fleet — one node's spec ##################################################################
  # Topology is zone-NESTED: fleet.zones.<zone>.nodes.<node>. There is no flat fleet.nodes path.
  # Deltas deep-merge per leaf, so this bumps one node and inherits everything else.
  # fleet.zones."sim-zone".nodes.cpu-1.memory_mb = 16384;
  # fleet.zones."sim-zone".nodes.cpu-1.cpus = 8;

  # `enable = false` drops a base node without mkForce. A node's flat list POSITION derives its
  # data/BMC IP and Device UUID, so dropping a non-terminal node re-identifies every node after it.
  # fleet.zones."sim-zone".nodes.cpu-4.enable = false;

  ## Fleet — a second zone ####################################################################
  # A zone is one spoke-group. Each needs a unique `index` (0 is the base zone) and gets its own
  # spoke process (`spoke-<name>`), Redis prefix and Zone UUID. Its nodes append after zone 0's,
  # so MACs must not collide with the committed base (…:0:01 through …:0:04 at slot 0).
  # fleet.zones."sim-zone-2" = {
  #   index = 1;
  #   bridges = 1;
  #   nodes = {
  #     cpu-1 = {
  #       ipmi_mac = "52:54:00:bc:00:05";
  #       data_mac = "52:54:00:da:00:05";
  #     };
  #     cpu-2 = {
  #       ipmi_mac = "52:54:00:bc:00:06";
  #       data_mac = "52:54:00:da:00:06";
  #     };
  #   };
  # };

  # Two bridges in one zone = the HA pair a leader election (and the VRRP demo below) needs.
  # fleet.zones."sim-zone".bridges = 2;

  ## Fleet — real hardware instead of VMs #####################################################
  # Mutually exclusive with the VM fleet above: mode = "baremetal" renders an empty `nodes` list.
  # iface/ifaceIp are a REAL host NIC and its IPv4 — the eval asserts both are set in this mode.
  # bmc_mac is required (no synthetic fallback); credentials are sealed separately, never here.
  # fleet.mode = "baremetal";
  # fleet.baremetal = {
  #   iface = "eno1";
  #   ifaceIp = "10.0.0.10";
  #   arch = "amd64";
  #   nodes = {
  #     bm-1 = {
  #       pxe_mac = "aa:bb:cc:dd:ee:01";
  #       bmc_ip = "10.0.0.101";
  #       bmc_mac = "aa:bb:cc:dd:ee:02";
  #     };
  #   };
  # };

  ## Service ports #############################################################################
  # Only the `portGroups.editable` keys are meant to move; the control center's own ports and the
  # hub/spoke replica port math derive from the slot. A change ripples to the bind, every
  # readiness probe and every derived URL. Prefer a stack slot when the goal is a second stack.
  # ports.postgres = 15432;
  # ports.redis = 16379;
  # ports.mailpitWeb = 18025;

  ## Observability + network exposure ##########################################################
  # Brings up the local OTel collector -> Tempo -> Grafana sink and points the hub's exporter at
  # it. Off by default; the exporter env renders at eval time, so a flip needs a hub-api restart.
  # telemetry.enable = true;

  # How this stack is reached. `direct` binds the otherwise loopback-only datastores and services on
  # the LAN in cleartext — only on a network you trust. `fronted` keeps every listener on loopback
  # for a terminator you run yourself (tailscale serve, ssh -L, caddy) and makes EVERY caller present
  # the control-center token, loopback included: behind a front door a loopback peer is whoever the
  # front door serves. `lan.expose = true` still works and means `direct`.
  # lan.mode = "direct";

  # One address for the `direct` listeners instead of every interface. An IP literal only — this value
  # reaches a socket, and a name resolves to several addresses and binds one of them twice.
  # lan.bindAddress = "192.168.1.50";

  # The name a browser reaches this stack at. It never reaches a socket, so unlike the bind address it
  # takes a name: the one a `fronted` terminator serves, or the one a `direct` LAN client types.
  # lan.publicHost = "dev-box.local";

  # On by default: under `direct`, off-loopback datastore clients must present a credential
  # (Postgres scram, Redis requirepass, Mailpit basic auth) and Thanos receive stays on loopback.
  # Set false to keep the old credential-free LAN posture.
  # lan.datastoreAuth = false;
  # identity.redis.password = "...";
  # identity.mailpit.password = "...";

  ## Sim harnesses #############################################################################
  # Per-zone Redis ACL users are ON by default (the sim exercises the rule self-hosters get).
  # false returns to the pre-ACL sim: spokes on the default user, hub flag off.
  # redisAcl.enable = false;

  # VRRP VIP failover e2e: puts a sim ip/arping shim on each bridge's PATH so nothing binds a real
  # address. Opt-in. A failover demo also needs two bridges in the zone (see above), and the VIP
  # itself is created in IPAM and attached to a NIC through the hub UI, exactly like production.
  # vrrpSim.enable = true;

  ## Polyrepo + assets #########################################################################
  # Where the hub checkout lives, when it is not this repo. Empty means this repo.
  # polyrepo.hub.path = "~/projects/work/hydra/brokkr-app";

  # The CDN asset origin the OS-layer cache proxies and the spoke's DISCOVERY_BASE_URL derives
  # from — repoint it at a mirror for an air-gapped run.
  # osLayerCache.originHost = "assets.mirror.internal";
}
