# Dependencies
node_modules
**/node_modules

# Build outputs
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo
.turbo
**/.turbo
out

# Development files
.git
.gitignore
*.md
LICENSE
# Attribution files must ship in release images.
!LICENSE
!NOTICE
!THIRD-PARTY-LICENSES.md

# IDE
.vscode
.idea
*.swp
*.swo

# Environment files (don't bake secrets into images)
.env
.env.*
!.env.example

# Test files
coverage
**/*.test.ts
**/*.spec.ts
# Only the app/package-level vitest roots — NOT nested src/ modules that happen
# to be named "test" (e.g. apps/live-agent/src/operations/test ships in the image).
apps/*/test
packages/*/test
**/__tests__

# Misc
.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*
