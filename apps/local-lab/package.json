{
  "name": "local-lab",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && node scripts/write-build-info.mjs",
    "serve": "nest build && node scripts/write-build-info.mjs && node dist/main",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@repo/local-lab-contract": "workspace:*",
    "@repo/utils": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "@ts-rest/nest": "^3.51.0",
    "@ts-rest/open-api": "^3.52.1",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.67.3",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.3.0",
    "node-pty": "^1.1.0",
    "pg": "^8.21.0",
    "redoc": "2.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "5.17.14",
    "undici": "^8.5.0",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@repo/eslint-config": "workspace:*",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.31.0",
    "typescript": "5.5.4",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.17"
  }
