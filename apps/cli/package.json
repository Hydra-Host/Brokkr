{
  "name": "@repo/cli",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": {
      "types": "./dist/browser-entry.d.ts",
      "default": "./dist/brokkr-browser.mjs"
    }
  },
  "bin": {
    "brokkr": "./dist/index.js",
    "brokkr-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx src/mcp/index.ts",
    "build": "tsc && node build-browser.mjs",
    "build:browser": "node build-browser.mjs",
    "build:npm": "pnpm --filter @repo/api-client build && node build-node.mjs && node publish-prepare.mjs",
    "publish:npm:dry": "pnpm build:npm && cd npm-package && npm publish --dry-run",
    "publish:npm": "pnpm build:npm && cd npm-package && npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@repo/api-client": "workspace:*",
    "@repo/utils": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "ink": "^6.1.1",
    "ora": "^8.2.0",
    "react": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.0.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.17"
  }
}
