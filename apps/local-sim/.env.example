# Sample apps/local-sim/.env — `cp .env.example .env`, then uncomment what you need. Everything is
# commented out, so the copy changes nothing.
#
# THIS IS NOT the repo-root .env. Two files, two loaders, two different sets of rules:
#
#   apps/local-sim/.env   read by pydantic-settings at process start. `_config()` in
#                         scripts/local/config.py sets env_file to REPO/.env, and REPO there is
#                         apps/local-sim (config.py's parents[2]) — not the monorepo root.
#   .env (repo root)      read by devenv's `dotenv` integration at Nix eval time, and limited to
#                         the config.env entries devenv.nix marks lib.mkOptionDefault. Different
#                         keys — see the override-layer table in devenv/README.md. The repo ships
#                         no root sample on purpose: devenv prints a `cp .env.example .env` hint on
#                         every shell entry whenever one exists, and the hermetic path needs no .env.
#
# PRECEDENCE: pydantic-settings ranks the ambient environment ABOVE this file. Inside the devenv
# shell the env block already exports the variables in the first section below, so setting one of
# those here is inert under `task up` — it only takes effect when the engine runs standalone,
# outside the shell. The second section is the part this file really governs.
#
# Values are parsed by python-dotenv: trailing `# comments` are stripped and quotes are honored.
# (The root .env's parser does neither — do not carry habits between the two files.) Only
# LOCAL_STATE and HUB_REPO_PATH expand a leading `~` / `$VAR`; every other path variable is taken
# literally, so write those absolute.
#
# `python -m local.show_config` prints every resolved value and tags each `env`, `default` or
# `computed`, which is the fastest way to see whether a line here actually landed.

# ---------------------------------------------------------------------------------------------
# Exported by the devenv shell — inert under `task up`, effective only for a standalone engine.
# Defaults shown are config.py's own, which is what a standalone run falls back to.
# ---------------------------------------------------------------------------------------------

# State root for boot artifacts, overlays, rendered XMLs, pidfiles, NVRAM and wipe memos.
# LOCAL_STATE=~/.local/share/local

# Fleet topology the engine loads. devenv renders it to a store path and points this at a writable
# copy under .devenv/state; standalone it falls back to fleet.local.yml, else fleet.yml.
# LOCAL_FLEET_PATH=./fleet.local.yml

# Python environment bin dir; the sushy-emulator path derives from it.
# LOCAL_PYTHON_BIN=/usr/local/bin

# qemu binary baked into each rendered libvirt XML as <emulator>, and the EDK2 firmware loaded
# alongside direct-kernel boot so /sys/firmware/efi appears in the guest. All auto-detected.
# LOCAL_QEMU_EMULATOR=/usr/local/bin/qemu-system-aarch64
# LOCAL_EDK2_CODE_PATH=/usr/local/share/qemu/edk2-aarch64-code.fd
# LOCAL_EDK2_VARS_TEMPLATE_PATH=/usr/local/share/qemu/edk2-arm-vars.fd

# OpenIPMI lanserv (the BMC plane) and the privileged sim helper, both sudo-launched by absolute
# path. The defaults are the out-of-devenv fallbacks.
# LOCAL_IPMI_SIM_BIN=/opt/openipmi/bin/ipmi_sim
# LOCAL_SIM_PRIV_BIN=/opt/brokkr-sim-priv/bin/brokkr-sim-priv

# Flat-L2 data-plane kernel bridge each domain's <interface><source bridge=> points at.
# LOCAL_DATA_BRIDGE=br-brokkr

# socket_vmnet binary. macOS only; Linux uses libvirt's native bridge network.
# LOCAL_SOCKET_VMNET_BIN=/opt/socket_vmnet/bin/socket_vmnet

# Zone UUID for Redis key namespacing and Zone.id in Hub Postgres.
# BRIDGE_ZONE_ID=00000000-0000-0000-0000-111111111111

# The monorepo checkout brokkr-live.img is cpio-packed from. Defaults to the checkout this file
# lives in, so it is already correct for any clone path.
# HUB_REPO_PATH=~/projects/work/hydra/boss

# Multi-stack slot — namespaces the bootptab section marker and the libvirt managed-tag.
# SIM_SLOT=0

# Organization.id the zone seed FK-references, and the OS-layers release index the catalog seed
# follows.
# SIM_HYDRAHOST_ORG_ID=00000000-0000-0000-0000-000000000000
# SIM_OS_LAYERS_MANIFEST_INDEX_URL=https://brokkr.assets.hydra.host/os-layers/releases/latest

# Hub Postgres and Bridge Redis.
# HUB_DATABASE_URL=postgresql://brokkr:password@localhost:5432/brokkr
# BRIDGE_REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------------------------
# Not exported by the devenv shell — this file is the override point, in or out of `task up`.
# ---------------------------------------------------------------------------------------------

# Jinja template root and the Docker base image for the iPXE + GRUB builds.
# LOCAL_TEMPLATES_DIR=./templates
# LOCAL_BUILD_BASE_IMAGE=ubuntu:24.04

# libvirt URI. Auto-detected: the user-session virtqemud socket on macOS, qemu:///system on Linux.
# LOCAL_LIBVIRT_URI=qemu:///system

# Where the sim fetches boot artifacts from, and where the bridge serves initrd builds. iPXE
# rewrites 127.0.0.1 to the data-plane gateway at build time, since the VM's localhost is not
# the host's.
# BRIDGE_ENDPOINT=http://127.0.0.1:8000
# BRIDGE_PERSISTENT_STORAGE=/tmp/brokkr-dev

# bridge-api's SSH public key, staged into the cpio overlay so root SSH into a sim works. Not
# `~`-expanded — the default below is resolved in Python, an override here is not.
# BRIDGE_SSH_KEY_PATH=/Users/you/.config/bridge-api/ssh-key.pub

# Hub main API. The devenv stack scales hubs at 3000 + 2i.
# HUB_ENDPOINT=http://127.0.0.1:3000

# Sim zone naming and count. Zone i derives its UUID, name and ports from the count; nodes
# round-robin onto zones by fleet position.
# SIM_ZONE_NAME=sim-zone
# SIM_ZONE_COUNT=1

# NetBox site/location the seeded zone references, and the tenant id on the Hydra Host org.
# SIM_NETBOX_SITE_ID=1
# SIM_NETBOX_LOCATION_ID=1
# SIM_ORG_TENANT_ID=1
# SIM_HYDRAHOST_ORG_NAME=Brokkr Org

# Architecture stamped onto every seeded Device, so the OS-layer resolver picks the matching
# artifact. Auto-detected from the host; set it to force cross-arch seeding.
# SIM_HOST_ARCH=arm64

# Device name representing the local bridge in Bridge Redis.
# SIM_BRIDGE_NAME=sim-bridge

# Port sushy-emulator binds on each BMC IP for Redfish. Read at BMC startup, so a change applies
# on the next fleet rebuild, not a live restart.
# SIM_REDFISH_PORT=8443

# DNS resolvers baked into the sim netplan — comma-separated. The data-plane gateway runs no
# resolver, so sims must reach public DNS directly.
# SIM_NAMESERVERS=1.1.1.1,8.8.8.8

# TTL for the Bridge Redis device-record cache.
# CACHE_TTL_SECONDS=86400
