{
  "availability": "{\"max_restarts\": 5, \"restart\": \"on_failure\"}",
  "command": "exec /nix/store/$HASH-rust_devenv-tasks-$DEVENV_TASKS/bin/devenv-tasks run --task-file /nix/store/$HASH-tasks.json --mode all --cache-dir $REPO/.devenv --runtime-dir /run/user/$UID/devenv-$ID --ignore-process-deps devenv:processes:spoke",
  "depends_on": "{\"redis\": {\"condition\": \"process_healthy\"}}",
  "description": "\"Bridge\"",
  "disabled": "null",
  "entrypoint": "null",
  "environment": [
    "AGENT_BUNDLE_PATH=/opt/brokkr/agent/main.js",
    "AGENT_SSH_FORCE_REDEPLOY=true",
    "AGENT_UNIT_PATH=/opt/brokkr/agent/brokkr-bridge-agent.service",
    "ANALYTICS_ENABLED=false",
    "ASYNCSSH_LOG_LEVEL=WARNING",
    "BRIDGE_API_URL=http://127.0.0.1:8000",
    "BRIDGE_API_VERSION=0.0.0-dev",
    "BRIDGE_AT_REST_KEY=$AT_REST_KEY",
    "BRIDGE_HOSTNAME=spoke",
    "BRIDGE_ORCHESTRATOR_ENABLED=true",
    "BRIDGE_REGISTRATION_TOKEN_FILE=$REPO/.devenv/state/zone-crypto/tokens/sim-zone.token",
    "BRIDGE_SSH_PRIVKEY_PATH=$HOME/.ssh/id_ed25519",
    "BRIDGE_SYNC_ENABLED=true",
    "BRIDGE_URL=http://192.168.200.1:8000",
    "BRIDGE_ZONE_CRYPTO_MARKER_PATH=/tmp/brokkr-dev/spoke/zone-crypto.lock",
    "BROKKR_ENV=local",
    "BROKKR_HUB_URL=http://127.0.0.1:3000",
    "BROKKR_LIVE_VERSION=1.1.8",
    "BROKKR_REGISTRATION_TOKEN=",
    "BROKKR_ZONE_ID=00000000-0000-0000-0000-111111111111",
    "COLLECTION_WORKER_CONCURRENCY=1",
    "DISCOVERY_ARCHITECTURES=$ARCH",
    "DISCOVERY_BASE_URL=https://brokkr.assets.hydra.host/brokkr-live",
    "DISCOVERY_FLAVORS=light",
    "ENVIRONMENT=dev",
    "GRPC_EXTERNAL_PORT=9082",
    "GRPC_INSECURE=true",
    "GRPC_INTERNAL_HOST=0.0.0.0",
    "GRPC_INTERNAL_PORT=9082",
    "HH_ENV=dev",
    "HOST=0.0.0.0",
    "HTTPS_DOWNLOAD_TIMEOUT=3600",
    "HTTPS_RETRY_ATTEMPTS=3",
    "HTTPS_RETRY_DELAY=5",
    "HTTPS_VERIFY_SSL=true",
    "LIFECYCLE_WORKER_CONCURRENCY=10",
    "LOCAL_SIMULATION_ENABLED=true",
    "LOG_FORMAT=console",
    "LOG_LEVEL=debug",
    "MONITORING_LOGS_ENABLED=false",
    "OS_LAYER_URL=http://192.168.200.1:8888/assets",
    "PERSISTENT_STORAGE_PATH=/tmp/brokkr-dev/spoke",
    "PORT=8000",
    "REDIS_PREFIX=00000000-0000-0000-0000-111111111111",
    "REDIS_URL=redis://brokkr-spoke-00000000-0000-0000-0000-111111111111:sim-acl-sim-zone-nonsecret@127.0.0.1:6379",
    "SIM_BMC_CIDR=192.168.105.0/24",
    "SIM_REDFISH_PORT=8443",
    "SSH_KEY_PATH=$HOME/.ssh/id_ed25519",
    "TELEGRAF_ENABLED=true",
    "TELEGRAF_HTTP_TIMEOUT=10s",
    "TELEGRAF_OWNED_CONF_PATH=$REPO/.devenv/state/telegraf/spoke/telegraf.d/owned.conf",
    "TELEGRAF_POLL_INTERVAL=30s",
    "TFTP_ENABLED=false"
  ],
  "exec": "#!/nix/store/$HASH-bash-interactive-5.3p9/bin/bash\nset -e\n__repo=\"${HUB_REPO_PATH/#\\~/$HOME}\"; __repo=\"${__repo/#\\$HOME/$HOME}\"; cd \"$__repo\"\nexport ASSETS_DIR=\"$PWD/apps/bridge/assets\"\nif [ -z \"${BROKKR_REGISTRATION_TOKEN:-}\" ] && [ -s \"${BRIDGE_REGISTRATION_TOKEN_FILE:-}\" ]; then\n  export BROKKR_REGISTRATION_TOKEN=\"$(cat \"$BRIDGE_REGISTRATION_TOKEN_FILE\")\"\nfi\n# VRRP sim e2e (modules/vrrp-sim.nix, opt-in): put the fake `ip`/`arping` first on PATH\n# so the reconciler binds VIPs against a state file, not a real interface. No-op when unset.\nif [ -n \"${VRRP_SIM_SHIM_DIR:-}\" ]; then\n  export PATH=\"$VRRP_SIM_SHIM_DIR:$PATH\"\nfi\nBRIDGE_NODE_BIN=\"${BRIDGE_NODE_BIN:-node}\"\nif [ \"$BRIDGE_NODE_BIN\" != node ] && [ ! -x \"$BRIDGE_NODE_BIN\" ]; then\n  echo \"capped node binary missing at $BRIDGE_NODE_BIN \u2014 run the fleet planes Apply from the control center (provisions the ambient-cap wrapper)\" >&2\n  exit 1\nfi\n# --watch: restart when spoke-watch rewrites dist. Caps survive reloads \u2014 the bm\n# BRIDGE_NODE_BIN is a setcap'd COPY of node, and watch re-execs that same inode.\nexec \"$BRIDGE_NODE_BIN\" --watch --watch-preserve-output apps/bridge/dist/main.js\n\n\n",
  "extensions": "null",
  "is_elevated": "null",
  "liveness_probe": "null",
  "log_location": "null",
  "namespace": "\"spoke\"",
  "readiness_probe": "{\"failure_threshold\": 60, \"http_get\": {\"host\": \"127.0.0.1\", \"path\": \"/api/health\", \"port\": 8000, \"scheme\": \"http\"}, \"initial_delay_seconds\": 3, \"period_seconds\": 2, \"success_threshold\": 1, \"timeout_seconds\": null}",
  "replicas": "null",
  "shutdown": "{\"parent_only\": false, \"signal\": 15, \"timeout_seconds\": 10}",
  "working_dir": "null"
}
