  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-strip-types' nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "docs:generate": "tsx src/scripts/openapi/generate-openapi.ts",
    "docs:generate:html": "pnpm --filter api docs:generate",
    "key:generate-hub": "tsx src/scripts/generate-hub-key.ts",
    "mint:sim-token": "tsx src/scripts/mint-sim-registration-token.ts",
    "seed:sim-bmc": "tsx src/scripts/seed-sim-bmc-secrets.ts",
