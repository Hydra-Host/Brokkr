{# Telegraf config for devices this bridge owns. Auto-generated by
   bridge-api's TelegrafConfigWriter — do not edit by hand. Output is
   deterministic for a given input so the writer can hash-compare to
   skip no-op rewrites.

   Vendor specifics (which Redfish endpoints, GPU counts, unit conversions)
   live server-side in the /api/monitoring/device/sensors aggregate endpoint,
   not here. Each device gets the SAME two stanzas regardless of vendor:
   an ICMP probe and one device-sensors scrape whose response is a uniform
   document keyed by metric name. #}
# Telegraf config — bridge-owned devices.
# Auto-generated by bridge-api. Do not edit; changes are overwritten on
# the next render. Device count: {{ devices | length }}.
{# Chassis sensors tag by `sensor` (Redfish sensor Name); GPU sensors tag by
   `gpu_index`. The bridge always returns every key (empty when no data), so
   these fixed paths always resolve. #}
{% set chassis_sensors = ["sensor_temperature_celsius", "sensor_fan_rpm", "sensor_fan_percent", "sensor_voltage_volts", "sensor_psu_watts", "chassis_power_watts"] %}
{% set gpu_sensors = ["gpu_temperature_celsius", "gpu_memory_temperature_celsius", "gpu_power_watts", "gpu_memory_power_watts"] %}

{% for device in devices %}
# ─── device {{ device.device_id }} ───────────────

[[inputs.http]]
  urls = ["{{ config.bridge_api_url }}/api/monitoring/ping"]
  method = "POST"
  body = '{"device_id": {{ device.device_id | jsonstr }}}'
  timeout = "{{ config.timeout }}"
  interval = "{{ config.poll_interval }}"
  data_format = "json_v2"
  # Drop telegraf's default `url` tag (internal address; device_id identifies the series).
  tagexclude = ["url"]
  [inputs.http.headers]
    Content-Type = "application/json"
  [inputs.http.tags]
    device_id = "{{ device.device_id }}"
  [[inputs.http.json_v2]]
    measurement_name = "icmp"
    [[inputs.http.json_v2.field]]
      path = "metrics.icmpping"
      type = "int"
      rename = "reachable"
    [[inputs.http.json_v2.field]]
      path = "metrics.icmppingloss"
      type = "float"
      rename = "loss_ratio"
      optional = true
    [[inputs.http.json_v2.field]]
      path = "metrics.icmppingsec"
      type = "float"
      rename = "response_seconds"
      optional = true

{% if device.kind == "pdu" %}
{# PDU: telegraf polls SNMP directly (co-located on the bridge host). OID
   field/table set comes from the vendor profile; community is the shared v2c
   string telegraf reads from the ${PDU_SNMP_COMMUNITY} env var. #}
{% set profile = pdu_profiles.get(device.pdu_profile) %}
{% if profile %}
[[inputs.snmp]]
  name = "pdu"
  agents = ["udp://{{ device.bmc_ip }}:161"]
  version = 2
  community = "${PDU_SNMP_COMMUNITY}"
  timeout = "{{ config.timeout }}"
  interval = "{{ config.poll_interval }}"
  [inputs.snmp.tags]
    device_id = "{{ device.device_id }}"
    pdu_vendor = "{{ profile.vendor }}"
{% for f in profile.fields %}
  [[inputs.snmp.field]]
    name = "{{ f.name }}"
    oid = "{{ f.oid }}"
{% if f.conversion %}
    conversion = "{{ f.conversion }}"
{% endif %}
{% endfor %}
{% for table in profile.tables %}
  [[inputs.snmp.table]]
    name = "{{ table.name }}"
    index_as_tag = {{ "true" if table.index_as_tag else "false" }}
{% for tf in table.fields %}
    [[inputs.snmp.table.field]]
      name = "{{ tf.name }}"
      oid = "{{ tf.oid }}"
{% if tf.is_tag %}
      is_tag = true
{% endif %}
{% if tf.conversion %}
      conversion = "{{ tf.conversion }}"
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% else %}
[[inputs.http]]
  urls = ["{{ config.bridge_api_url }}/api/monitoring/device/sensors"]
  method = "POST"
{% if device.kind == "cdu" %}
  body = '{"device_id": {{ device.device_id | jsonstr }}, "kind": "cdu"}'
{% else %}
  body = '{"device_id": {{ device.device_id | jsonstr }}}'
{% endif %}
  timeout = "{{ config.timeout }}"
  interval = "{{ config.poll_interval }}"
  data_format = "json_v2"
  # Drop telegraf's default `url` tag (internal address; device_id identifies the series).
  tagexclude = ["url"]
  [inputs.http.headers]
    Content-Type = "application/json"
  [inputs.http.tags]
    device_id = "{{ device.device_id }}"
{% if device.kind == "cdu" %}
{# CDU (water-cooling): metric->tag list comes from cdu_scrape_plan.cdu_measurements(). #}
{% for measurement, tag in cdu_measurements %}
  [[inputs.http.json_v2]]
    measurement_name = "{{ measurement }}"
    [[inputs.http.json_v2.object]]
      path = "{{ measurement }}"
{% if tag %}
      tags = ["{{ tag }}"]
{% endif %}
      included_keys = ["value"]
{% endfor %}
{% else %}
{% for measurement in chassis_sensors %}
  [[inputs.http.json_v2]]
    measurement_name = "{{ measurement }}"
    [[inputs.http.json_v2.object]]
      path = "{{ measurement }}"
      tags = ["sensor"]
      included_keys = ["value"]
{% endfor %}
{% for measurement in gpu_sensors %}
  [[inputs.http.json_v2]]
    measurement_name = "{{ measurement }}"
    [[inputs.http.json_v2.object]]
      path = "{{ measurement }}"
      tags = ["gpu_index"]
      included_keys = ["value"]
{% endfor %}
{% endif %}
{% endif %}

{% endfor %}
