<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ api_title }} - Swagger UI</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@{{ swagger_version }}/swagger-ui.css" />
    <style>
  body {
    background-color: #100b09;
    color: #fff3ce;
    font-family: JetBrains Mono, monospace;
    margin: 0;
    padding: 0;
  }
  * { border-radius: 0 !important; }
  .swagger-ui { color: #fff3ce; font-family: JetBrains Mono, monospace; }
  .swagger-ui .model-toggle,
  .swagger-ui span.model-toggle,
  .swagger-ui span[class*="model-toggle"],
  .swagger-ui div[class*="model-box"] span[class*="model-toggle"],
  .swagger-ui div[class*="model"] span[class*="model-toggle"] {
    color: #fff3ce !important;
  }
  .swagger-ui .col_header { color: #fff3ce !important; }
  .swagger-ui table thead tr th,
  .swagger-ui table thead tr td { color: #fff3ce !important; }
  .swagger-ui .expand-operation svg,
  .swagger-ui .opblock-summary-control svg,
  .swagger-ui .arrow { fill: #fff3ce !important; }
  .swagger-ui .opblock-tag { color: #fff3ce !important; border-bottom-color: #ffdc75; }
  .swagger-ui .opblock-tag-section { color: #fff3ce; }
  .swagger-ui .opblock-tag a { color: #fff3ce !important; }
  .swagger-ui .opblock-tag small { color: #ad9985; }
  .swagger-ui .info .title,
  .swagger-ui .info h1,
  .swagger-ui .info h2,
  .swagger-ui .info h3,
  .swagger-ui .info h4,
  .swagger-ui .info h5,
  .swagger-ui .info li,
  .swagger-ui .info p,
  .swagger-ui .info table { color: #fff3ce !important; }
  .swagger-ui .opblock .opblock-summary-description,
  .swagger-ui .opblock .opblock-summary-operation-id,
  .swagger-ui .opblock .opblock-summary-path,
  .swagger-ui .opblock .opblock-summary-path__deprecated { color: #fff3ce; }
  .swagger-ui .opblock { background-color: #19120f; border-color: #3f3430; }
  .swagger-ui .opblock.opblock-get { background-color: rgba(96, 165, 250, 0.08); }
  .swagger-ui .opblock.opblock-post { background-color: rgba(111, 236, 79, 0.08); }
  .swagger-ui .opblock.opblock-delete { background-color: rgba(255, 56, 59, 0.08); }
  .swagger-ui .opblock.opblock-put { background-color: rgba(251, 212, 36, 0.08); }
  .swagger-ui .opblock.opblock-patch { background-color: rgba(255, 220, 117, 0.08); }
  .swagger-ui .scheme-container { background-color: #100b09; }
  .swagger-ui .btn { background-color: #19120f; color: #fff3ce; border-color: #ffdc75; }
  .swagger-ui select { background-color: #19120f; color: #fff3ce; border-color: #ffdc75; }
  .swagger-ui select option { background-color: #19120f; color: #fff3ce; }
  select, option, optgroup { background-color: #19120f !important; color: #fff3ce !important; }
  [role="listbox"], [role="option"],
  .select-container ul, .select-container li, .select-container .options {
    background-color: #19120f !important; color: #fff3ce !important;
  }
  .swagger-ui .parameter__name, .swagger-ui .parameter__type { color: #ffdc75; }
  .swagger-ui .parameter__extension, .swagger-ui .parameter__in { color: #ad9985; }
  .swagger-ui input[type=text] { background-color: #19120f; color: #fff3ce; }
  .swagger-ui textarea { background-color: #19120f !important; color: #fff3ce !important; }
  .swagger-ui .topbar { background-color: #100b09; }
  .swagger-ui .model { color: #fff3ce; }
  .swagger-ui .model-title { color: #fff3ce; }
  .swagger-ui .model .property { color: #ffdc75; }
  .swagger-ui .model .property.primitive { color: #6fec4f; }
  .swagger-ui .prop-type { color: #ad9985; }
  .swagger-ui .response-col_status { color: #fff3ce; }
  .swagger-ui .response-col_description { color: #fff3ce; }
  .swagger-ui .responses-table tbody tr td:first-of-type { color: #fff3ce; }
  .swagger-ui .tab li { color: #fff3ce; }
  .swagger-ui .opblock-description-wrapper p { color: #fff3ce; }
  .swagger-ui .opblock-external-docs-wrapper { color: #fff3ce; }
  .swagger-ui .renderedMarkdown { color: #fff3ce; }

  div[class*="response-schema"],
  div[class*="response-schema"] div { background-color: #100b09 !important; }
  div[class*="response-schema"] span { background-color: transparent !important; }
  div[class*="response-schema"] h5,
  div[class*="response-schema"] p,
  div[class*="response-schema"] span { color: #fff3ce !important; }
  div[class*="response-schema"] .token.property { color: #ffdc75 !important; }
  div[class*="response-schema"] .token.string { color: #6fec4f !important; }
  div[class*="response-schema"] .token.number { color: #60a5fa !important; }
  div[class*="response-schema"] .token.boolean { color: #fbd424 !important; }
  div[class*="response-schema"] .required { color: #ff383b !important; }
  h5[class*="sc-"] { color: #fff3ce !important; }
  h5[class*="sc-"] > span[class*="sc-"] { color: #fff3ce !important; }
  span[class*="property-name"] { color: #ffdc75 !important; }
  .required { color: #ff383b !important; }

  .swagger-ui .models h4, .swagger-ui .models h5,
  .swagger-ui .models .model-title, .swagger-ui .models .model-toggle,
  .swagger-ui .models .model-box, .swagger-ui .models .model-box *,
  .swagger-ui .models .model-name, .swagger-ui .models .model-container,
  .swagger-ui .models .model-schema, .swagger-ui .models .arrow,
  .swagger-ui .models svg { color: #fff3ce !important; fill: #fff3ce !important; }
  .swagger-ui .model-toggle:after { display: none !important; }

  .swagger-ui .dialog-ux .modal-ux { background-color: #100b09; border: 1px solid #ffdc75; }
  .swagger-ui .dialog-ux .modal-ux-header,
  .swagger-ui .dialog-ux .modal-ux-content,
  .swagger-ui .dialog-ux .modal-ux-header h3 {
    background-color: #100b09; color: #fff3ce; border-color: #ffdc75;
  }
  .swagger-ui .dialog-ux .modal-ux-header .close-modal { color: #fff3ce; }
  .swagger-ui .auth-container,
  .swagger-ui .auth-container h1, .swagger-ui .auth-container h2,
  .swagger-ui .auth-container h3, .swagger-ui .auth-container h4,
  .swagger-ui .auth-container h5, .swagger-ui .auth-container h6,
  .swagger-ui .auth-container label, .swagger-ui .auth-container p,
  .swagger-ui .auth-container strong, .swagger-ui .auth-container small {
    color: #fff3ce !important;
  }
  .swagger-ui .auth-container input[type=text],
  .swagger-ui .auth-container input[type=password] {
    background-color: #19120f; color: #fff3ce; border: 1px solid #ffdc75;
  }
  .swagger-ui .auth-btn-wrapper { display: flex; padding: 10px 0; justify-content: flex-end; }
  .swagger-ui .auth-btn-wrapper .btn-done { background-color: #ffdc75; color: #100b09; border-color: #ffdc75; }
  .swagger-ui .auth-btn-wrapper .btn-cancel { background-color: #19120f; color: #fff3ce; border-color: #ffdc75; }
  .swagger-ui .auth-btn-wrapper .btn { margin-left: 10px; }
  .swagger-ui .auth-container .logout-btn { background-color: #19120f; color: #fff3ce; border-color: #ffdc75; margin-right: 10px; }
  .swagger-ui .scopes { background-color: #100b09; color: #fff3ce; }
  .swagger-ui .scopes h2 { color: #fff3ce; }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #100b09; }
  ::-webkit-scrollbar-thumb { background: #3f3430; }
  ::-webkit-scrollbar-thumb:hover { background: #978243; }
    </style>
</head>
<body>
    <div id="swagger-ui"></div>
    <script src="https://unpkg.com/swagger-ui-dist@{{ swagger_version }}/swagger-ui-bundle.js" crossorigin></script>
    <script>
        window.onload = () => {
            window.ui = SwaggerUIBundle({
                url: '/apispec.json',
                dom_id: '#swagger-ui',
                presets: [
                    SwaggerUIBundle.presets.apis,
                    SwaggerUIBundle.presets.standalone
                ],
                plugins: [
                    SwaggerUIBundle.plugins.DownloadUrl
                ],
                ...{{ swagger_config_json | safe }}
            });
        };
    </script>
</body>
</html>
