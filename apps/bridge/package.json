{
  "name": "bridge",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Brokkr Bridge — TypeScript port of bridge-api. Hub-to-device gateway: HTTP, BullMQ workers, gRPC dispatch, saga workflows, telegraf monitoring.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "build:watch": "nest build --watch --config nest-cli.watch.json",
    "start": "nest start",
    "start:prod": "NODE_ENV=production node dist/main",
    "test": "vitest run --passWithNoTests",
    "test:redelay": "node scripts/redelay-probe.cjs",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:parity": "vitest run test/parity/",
    "test:integration": "vitest run src/__test__/composition-root-integration.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.4",
    "@grpc/proto-loader": "^0.7.13",
    "@hydrahost/bridge-plugin-hello-world": "workspace:*",
    "@hydrahost/plugin-sdk": "workspace:*",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-fastify": "^11.1.11",
    "@opentelemetry/api": "1.9.1",
    "@repo/bridge-agent-protocol": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "@repo/utils": "workspace:*",
    "@types/ssh2": "^1.15.5",
    "bullmq": "^5.67.3",
    "fastify": "^5.0.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.3.0",
    "net-snmp": "^3.26.3",
    "nunjucks": "^3.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "snappyjs": "0.7.0",
    "ssh-config": "^5.1.0",
    "ssh2": "^1.17.0",
    "undici": "^8.4.1",
    "yaml": "^2.9.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.11",
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/nunjucks": "^3.2.6",
    "@types/snappyjs": "^0.7.1",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.31.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^4.0.17"
  }
}
