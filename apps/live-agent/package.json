{
  "name": "bridge-agent",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Device-side agent. Maintains persistent gRPC sessions to all bridges in the zone and executes named operations on their behalf.",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "cd ../.. && buf generate",
    "build": "pnpm gen && tsup",
    "dev": "pnpm gen && tsx watch src/main.ts",
    "typecheck": "pnpm gen && tsc --noEmit",
    "test": "pnpm gen && vitest run",
    "test:watch": "pnpm gen && vitest",
    "clean": "rm -rf dist src/gen *.tsbuildinfo",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@hydrahost/bridge-plugin-hello-world": "workspace:*",
    "@hydrahost/plugin-sdk": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/otlp-transformer": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@repo/bridge-agent-protocol": "workspace:*",
    "@repo/utils": "workspace:*",
    "js-yaml": "^4.3.0",
    "nunjucks": "^3.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/nunjucks": "^3.2.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
