GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=hidden
GRUB_TIMEOUT=5
GRUB_RECORDFAIL_TIMEOUT=5
GRUB_DISABLE_OS_PROBER=true
{% if gpu_model is defined and gpu_model and 'gh200' in (gpu_model | lower) -%}
GRUB_CMDLINE_LINUX_DEFAULT="memhp_default_state=online_movable"
{% else -%}
GRUB_CMDLINE_LINUX_DEFAULT=""
{% endif -%}
{% set gpu_params = ' iommu=pt nvidia-drm.modeset=0' if gpu_model is defined and gpu_model else '' -%}
{% set pci_params = ' pci=realloc=off' if pci_realloc_off is defined and pci_realloc_off else '' -%}
{% if serial_ports and serial_ports.port -%}
{% set serial_port = serial_ports.port -%}
{% set serial_baud = serial_ports.baud or 115200 -%}
{% set serial_unit = (serial_port | last) if (serial_port | startswith('ttyS')) else '0' -%}
GRUB_CMDLINE_LINUX="quiet splash nohibernate{{ gpu_params }}{{ pci_params }} console=tty0 console={{ serial_port }},{{ serial_baud }}n8 earlyprintk={{ serial_port }},{{ serial_baud }} earlycon={{ serial_port }},{{ serial_baud }}{% if roce_iommu %} intel_iommu=on iommu=pt{% endif %}"
GRUB_SERIAL_COMMAND="serial --unit={{ serial_unit }} --speed={{ serial_baud }} --word=8 --parity=no --stop=1"
GRUB_TERMINAL="console serial"
{% else -%}
GRUB_CMDLINE_LINUX="quiet splash nohibernate{{ gpu_params }}{{ pci_params }} console=tty0{% if roce_iommu %} intel_iommu=on iommu=pt{% endif %}"
{% endif -%}
GRUB_SAVEDEFAULT=false
