#!/usr/bin/env bash

# Team shared envrc. devenv.nix + devenv.yaml + devenv.lock live at the repo root;
# modules and pkgs live under devenv/ (imported via ./devenv/modules/* in devenv.nix).
eval "$(devenv direnvrc)"
use devenv

# Source local overrides (repo-root relative, gitignored)
source_env_if_exists .envrc.local

# Watch for local control-panel knob overrides (imported by devenv.nix as ./stack.local.nix)
watch_file stack.local.nix

# Watch the slot claim pin (imported by devenv.nix as ./stack.slot.nix)
watch_file stack.slot.nix

# brokkr-app monorepo checkout (hub + bridge + agent) defaults from config.polyrepo
# (devenv/modules/polyrepo.nix); `task setup` clones it if missing. Override the declarative way
# (config.polyrepo.hub.path in devenv.local.nix), or set HUB_REPO_PATH in .envrc.local / .env.

[ -d "$HUB_REPO_PATH" ] || log_error "HUB_REPO_PATH=${HUB_REPO_PATH:-<unset>} is not a directory — run 'task setup', or set config.polyrepo.hub.path / HUB_REPO_PATH."

log_status "repo → ${HUB_REPO_PATH:-<unset>}"
