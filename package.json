{
  "name": "brokkr",
  "version": "0.0.0",
  "private": true,
  "description": "Brokkr — Hydra Host's bare-metal orchestration monorepo (hub + spoke + CLI + web).",
  "author": "Hydra Host",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "turbo run dev --filter=api --filter=web",
    "dev:main": "turbo run dev --filter=api --filter=web",
    "build": "turbo run build",
    "test": "turbo run test --filter=!@repo/e2e",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "format": "treefmt",
    "format:check": "treefmt --ci",
    "typecheck": "turbo run typecheck",
    "docker:build:api": "docker build -t api -f apps/api/Dockerfile .",
    "ci:test:e2e": "turbo run test:e2e",
    "test:playwright": "turbo run test:playwright --filter=@repo/e2e",
    "e2e:seed": "pnpm --filter @repo/e2e seed",
    "brokkr": "tsx apps/cli/src/index.ts",
    "gen:record": "tsx packages/active-record/src/generator/cli.ts",
    "plugins:uninstall": "tsx scripts/plugins-uninstall.ts",
    "licenses:third-party": "node scripts/generate-third-party-licenses.mjs",
    "lint:coverage": "node scripts/check-lint-coverage.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "licenses:test": "node --test scripts/generate-third-party-licenses.test.mjs"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.68.4",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "node-gyp": "^11.0.0",
    "pg": "^8.21.0",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "turbo": "^2.7.5"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.2.14",
      "multer": ">=2.2.0",
      "fast-xml-parser": ">=5.10.1",
      "axios": ">=1.16.0",
      "linkify-it": ">=5.0.2 <6.0.0",
      "kysely": ">=0.28.17",
      "hono": ">=4.12.26 <5.0.0",
      "@hono/node-server": ">=1.19.10 <2.0.0",
      "shell-quote": ">=1.8.4",
      "better-auth": ">=1.6.13 <1.7.0",
      "rollup": ">=4.59.0 <5.0.0",
      "effect": ">=3.20.0 <4.0.0",
      "picomatch@2": ">=2.3.2 <3.0.0",
      "picomatch@4": ">=4.0.4 <5.0.0",
      "path-to-regexp@8": ">=8.4.0 <9.0.0",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5 <7.0.0",
      "vite@7": ">=7.3.5 <8.0.0",
      "@nestjs/microservices": ">=11.1.19 <12.0.0",
      "fast-uri@3": ">=3.1.5 <4.0.0",
      "vitest@4": ">=4.1.0 <5.0.0",
      "@vitest/coverage-v8@4": ">=4.1.0 <5.0.0",
      "ws": ">=8.21.0",
      "form-data": ">=4.0.6",
      "find-my-way": ">=9.7.0 <10.0.0",
      "minimatch@3": ">=3.1.4 <4.0.0",
      "minimatch@9": ">=9.0.7 <10.0.0",
      "minimatch@10": ">=10.2.3 <11.0.0",
      "flatted": ">=3.4.2 <4.0.0",
      "serialize-javascript": ">=7.0.3 <8.0.0",
      "piscina": ">=4.9.3 <5.0.0",
      "@isaacs/brace-expansion": ">=5.0.1 <6.0.0",
      "brace-expansion@2": ">=2.1.4 <3.0.0",
      "brace-expansion@5": ">=5.0.9 <6.0.0",
      "js-yaml@4": ">=4.3.1 <5.0.0",
      "postcss@8": ">=8.5.18 <9.0.0",
      "seroval@1": ">=1.5.3 <2.0.0",
      "seroval-plugins@1": ">=1.5.3 <2.0.0",
      "d3-color": ">=3.1.0 <4.0.0",
      "undici": ">=8.9.0 <9.0.0",
      "ip-address@10": ">=10.3.1 <11.0.0",
      "geoip-lite": ">=2.0.3 <3.0.0",
      "nanoid@3": ">=3.3.17 <4.0.0",
      "deepmerge-ts": ">=8.0.0 <9.0.0"
    }
  },
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22.12 <25"
  }
}
