root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# markdown hard line breaks are two trailing spaces
[*.md]
trim_trailing_whitespace = false

# Makefiles require tab indentation
[{Makefile,*.mk}]
indent_style = tab
