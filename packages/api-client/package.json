{
  "name": "@repo/api-client",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract/index.d.ts",
        "default": "./dist/contract/index.mjs"
      },
      "require": {
        "types": "./dist/contract/index.d.ts",
        "default": "./dist/contract/index.js"
      }
    },
    "./contract/ipam": {
      "import": {
        "types": "./dist/contract/ipam.d.ts",
        "default": "./dist/contract/ipam.mjs"
      },
      "require": {
        "types": "./dist/contract/ipam.d.ts",
        "default": "./dist/contract/ipam.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.mjs"
      },
      "require": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    }
  },
  "scripts": {
    "generate:version": "node scripts/generate-version.js",
    "build": "node scripts/generate-version.js && tsup && tsc --emitDeclarationOnly",
    "dev": "node scripts/generate-version.js && tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "5",
    "@ts-rest/core": "^3.51.0",
    "@ts-rest/react-query": "^3.52.1",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.8.2",
    "vitest": "^4.0.17"
  }
}
