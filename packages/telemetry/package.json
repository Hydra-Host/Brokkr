{
  "name": "@repo/telemetry",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.cjs",
    "lgtm:up": "node scripts/lgtm.cjs up",
    "lgtm:down": "node scripts/lgtm.cjs down",
    "lgtm:status": "node scripts/lgtm.cjs status",
    "lgtm:dashboards": "node scripts/lgtm.cjs dashboards",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/otel": "0.20.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/instrumentation-express": "0.68.0",
    "@opentelemetry/instrumentation-grpc": "0.220.0",
    "@opentelemetry/instrumentation-http": "0.220.0",
    "@opentelemetry/instrumentation-ioredis": "0.68.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.66.0",
    "@opentelemetry/instrumentation-pg": "0.72.0",
    "@opentelemetry/instrumentation-runtime-node": "0.33.0",
    "@opentelemetry/instrumentation-undici": "0.30.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@prisma/instrumentation": "7.3.0",
    "bullmq-otel": "2.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "express": "^5.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
