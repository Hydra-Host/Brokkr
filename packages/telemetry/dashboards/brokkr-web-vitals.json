{
  "uid": "brokkr-web-vitals",
  "title": "Brokkr — Web Vitals",
  "tags": ["brokkr", "telemetry"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LCP p75",
      "description": "p75 is the web-vitals standard threshold percentile. Good < 2500 ms, poor > 4000 ms (web.dev).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_lcp_bucket{job=\"brokkr-hub\"}[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "INP p75",
      "description": "Good < 200 ms, poor > 500 ms (web.dev).",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_inp_bucket{job=\"brokkr-hub\"}[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
