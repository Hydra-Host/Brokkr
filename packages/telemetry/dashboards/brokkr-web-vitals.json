                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "TTFB p75",
      "description": "Good < 800 ms, poor > 1800 ms (web.dev).",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_ttfb_bucket{job=\"brokkr-hub\"}[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 800
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p75 over time — ms vitals",
      "description": "Values as web-vitals reports them (ms); the histograms carry no OTel unit so the prometheus names stay deterministic (brokkr_web_vitals_*_bucket).",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_lcp_bucket{job=\"brokkr-hub\"}[$__rate_interval])))",
          "legendFormat": "LCP"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_inp_bucket{job=\"brokkr-hub\"}[$__rate_interval])))",
          "legendFormat": "INP"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_fcp_bucket{job=\"brokkr-hub\"}[$__rate_interval])))",
          "legendFormat": "FCP"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_ttfb_bucket{job=\"brokkr-hub\"}[$__rate_interval])))",
          "legendFormat": "TTFB"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p75 over time — CLS",
      "description": "Separate panel: CLS is a unitless score, not ms.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (le) (rate(brokkr_web_vitals_cls_bucket{job=\"brokkr-hub\"}[$__rate_interval])))",
          "legendFormat": "CLS"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Measurements by rating (all vitals)",
      "description": "All five vitals pooled on the _count series; rating values are good / needs-improvement / poor. rate() drops __name__, which would collapse the five metrics into duplicate labelsets (a PromQL error), so label_replace first copies the vital name into a label via a subquery. The subquery needs its explicit 30s resolution: the default (the engine's 1m evaluation interval) leaves one point per window and rate() returns nothing.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rating) (rate(label_replace({__name__=~\"brokkr_web_vitals_(lcp|inp|cls|fcp|ttfb)_count\", job=\"brokkr-hub\"}, \"vital\", \"$1\", \"__name__\", \"brokkr_web_vitals_(lcp|inp|cls|fcp|ttfb)_count\")[$__rate_interval:30s]))",
          "legendFormat": "{{rating}}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "good"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "needs-improvement"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "poor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "By route (p75 LCP / INP)",
      "description": "Quantiles over the full dashboard range; Samples counts LCP reports (one per page load).",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.75, sum by (route, le) (rate(brokkr_web_vitals_lcp_bucket{job=\"brokkr-hub\"}[$__range])))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.75, sum by (route, le) (rate(brokkr_web_vitals_inp_bucket{job=\"brokkr-hub\"}[$__range])))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum by (route) (increase(brokkr_web_vitals_lcp_count{job=\"brokkr-hub\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "route": "Route",
              "Value #A": "p75 LCP",
              "Value #B": "p75 INP",
              "Value #C": "Samples"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Samples",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p75 LCP"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p75 INP"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    }
  ]
}
