    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Saga duration p95",
      "description": "brokkr_saga_duration_seconds histogram — empty until the instrument starts recording.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (saga_name, le) (rate(brokkr_saga_duration_seconds_bucket{job=\"brokkr-hub\"}[$__rate_interval])))",
          "legendFormat": "{{saga_name}}"
        }
