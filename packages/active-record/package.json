  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@repo/database": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
