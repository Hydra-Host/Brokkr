model User {
  id            String    @id @default(uuid())
  email         String    @unique @db.Citext
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  // Admin plugin fields
  role       String    @default("user")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  auth0Id                   String?                     @unique
  firstName                 String?
  lastName                  String?
  phoneNumber               String?                     @unique
  phoneNumberVerified       Boolean?                    @default(false)
  userEmailVerificationCode UserEmailVerificationCode[]

  organizationMembershipInvitations OrganizationMembershipInvitation[]
  sshKeys                           SshKeys[]
  organizationApiKey                OrganizationApiKey[]
  reservations                      Reservation[]
  deployments                       Deployment[]
  deploymentLifecycleActions        DeploymentLifecycleAction[]
  interruptibleClaim                InterruptibleClaim[]
  sessions                          Session[]
  accounts                          Account[]
  members                           Member[]
  invitations                       Invitation[]
  twoFactor                         TwoFactor?
  twoFactorEnabled                  Boolean?                           @default(false)
  apiKeys                           ApiKey[]
  lifecycleRequestsCreated          AdminLifecycleRequest[]            @relation("lifecycleRequestedBy")
  lifecycleRequestsApproved         AdminLifecycleRequest[]            @relation("lifecycleApprovedBy")
  cloudInitTemplates                CloudInitTemplate[]
  deviceDocuments                   DeviceDocument[]
  mintedZoneRegistrationTokens      ZoneRegistrationToken[] // S1 zone enrollment tokens minted by this admin
  deviceSecretsCreated              DeviceSecret[] // device secret versions written by this user
  importedBuilds                    LayerBuild[]                       @relation("importedBuilds")
  platformSettingsUpdates           PlatformSettings[]                 @relation("platformSettingsUpdates")
  notifications                     Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin plugin field for impersonation
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String    @default(uuid())
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  secret                  String?
  backupCodes             String?
  // Matches better-auth's declared default; the plugin always sets this explicitly on create
  // (false for fresh enrollments, true once verifyTotp succeeds).
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model UserEmailVerificationCode {
  id   String @id @default(uuid())
  code String

  dateCreated DateTime @default(now())
  dateExpires DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Whitelist {
  id        String  @id @default(uuid())
  auth0Id   String  @unique
  isBlocked Boolean @default(false)
}
