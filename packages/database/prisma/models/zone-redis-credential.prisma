// Per-zone Redis ACL credential for the opt-in self-hoster feature
// (REDIS_ACL_MANAGEMENT_ENABLED). When enabled, zone creation provisions a
// Redis ACL user `brokkr-spoke-<zoneId>` scoped to `~<zoneId>:* ~results:*`
// (mirroring zone-service's terraform rule used in Hydra's cloud).
//
// Only the SHA-256 hex hash of the password is persisted — the plaintext is
// returned exactly once in the create/rotate response, and the ACL user is
// managed via Redis's `#<sha256hex>` password form so reconciliation never
// needs the plaintext.

model ZoneRedisCredential {
  zoneId       String    @id
  passwordHash String // SHA-256 hex of the ACL password (raw never persisted)
  createdAt    DateTime  @default(now())
  rotatedAt    DateTime?

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}
