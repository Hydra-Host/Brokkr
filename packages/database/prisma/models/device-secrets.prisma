// Per-device secrets, stored under the existing zone envelope
// encryption. The hub SEALS each secret to the destination zone's enrollment
// key (zone_pub) and CANNOT open it; only that zone's bridge — the holder of
// zone_priv — can decrypt. The hub stores ciphertext only; viewing/using a
// secret routes the blob to the bridge to open (see secret.reveal saga).
//
// Append-only version history: `version` is monotonic per (deviceId, purpose);
// current = MAX(version) WHERE invalidatedAt IS NULL. Zone re-enrollment rotates
// the zone key — secrets sealed to the old generation become unopenable and are
// marked `invalidatedAt` (keyGen mismatch) ⇒ "credentials need re-entry".

enum DeviceSecretPurpose {
  BMC // baseboard management controller (IPMI/Redfish)
  CONSOLE // serial-over-LAN / console server
  // scales: SWITCH, PDU, …
}

enum DeviceSecretKind {
  USER // { user, pass }
  KEY // { public?, private }
  TOKEN // { token }
  CERT // { cert, key? }
}

// Durable audit trail for the per-device secret lifecycle (mirrors
// DeviceTokenAuditEvent). Every privileged touch of a secret — sealing a new
// version, requesting/delivering a plaintext reveal, dispatching the sealed blob
// to a zone bridge, or invalidating a stale-key version — appends one row here.
// These are SECURITY records, not logs: append-only and never mutated or pruned
// by app code. deviceId is an audit reference without an FK, so hard device
// deletion cannot remove the audit history.
enum DeviceSecretAuditEventType {
  WRITE // a new sealed version was appended by an operator
  UPDATE // an operator re-sealed an existing (device, purpose) — a superseding version
  REVEAL_REQUESTED // an operator/bridge asked to open a stored secret (round-trip kicked off)
  REVEAL_DELIVERED // plaintext was actually handed to the requester (the disclosure point)
  DISPATCH // the sealed blob was read out and forwarded to a zone bridge to open
  INVALIDATED // a version was marked unopenable (zone re-keyed, or explicit revoke)
}

// Who triggered an audited secret operation. USER = an interactive operator
// (createdById / session user); BRIDGE = a zone bridge acting over the queue;
// SYSTEM = the hub itself (e.g. stale-key invalidation on read, no human actor).
enum DeviceSecretActorType {
  USER
  BRIDGE
  SYSTEM
}

model DeviceSecretAuditEvent {
  id        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable: ephemeral seals (commissioning pre-flight / PXE enrichment) dispatch operator BMC creds to
  // a zone with NO persistent Device row, so the disclosure is recorded against `zoneId` instead.
  deviceId  String?
  // Zone a device-less (ephemeral) disclosure was dispatched to. Null on device-keyed events (the
  // device already scopes the zone). A CHECK constraint (migration 20260628010000) enforces that at
  // least one of deviceId/zoneId is set — Prisma can't model it, so it lives only in the migration.
  zoneId    String?
  event     DeviceSecretAuditEventType
  // Nullable: a REVEAL_DELIVERED with no correlated REVEAL_REQUESTED row (rare —
  // e.g. the request-time audit write failed) has no recoverable purpose, so it is
  // recorded null rather than a fabricated value.
  purpose   DeviceSecretPurpose?
  kind      DeviceSecretKind?
  version   Int?
  actorType DeviceSecretActorType
  // Free-form actor identifier: a user id (USER), a device/bridge id (BRIDGE),
  // or null/'system' (SYSTEM). Not an FK — actors span users, devices, and the hub.
  actor     String?
  // Reveal/dispatch correlation id (the saga requestId), present on the
  // request→deliver and dispatch flows so a disclosure can be traced end-to-end.
  requestId String?
  ip        String?
  userAgent String?
  // Structured cause/context (e.g. invalidation reason, stale keyGen). Never holds
  // secret material — plaintext is never written to the audit trail.
  payload   Json?
  createdAt DateTime                   @default(now())

  @@index([deviceId, createdAt])
  @@index([zoneId, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
}

model DeviceSecret {
  id       String              @id @default(uuid())
  deviceId String
  purpose  DeviceSecretPurpose
  kind     DeviceSecretKind
  version  Int // monotonic per (deviceId, purpose); current = MAX where not invalidated

  // auth-DH envelope sealed to the zone's zone_pub. nonce is derived from ephPub;
  // AAD is derived from the row (zone/device/purpose/kind/keyGen) and never stored.
  ephPub     Bytes
  ciphertext Bytes
  tag        Bytes

  zoneId        String // custody zone — sealed to this zone's enrollment key
  zoneKeyId     String // ZoneEnrollment.id that sealed it
  keyGen        Int // ZoneEnrollment.generation at seal time (rotation detection)
  invalidatedAt DateTime? // keyGen != the zone's current generation ⇒ needs re-entry

  createdAt   DateTime @default(now())
  createdById String // audit: who wrote this version

  device    Device @relation(fields: [deviceId, zoneId], references: [id, zoneId], onDelete: Cascade, onUpdate: Restrict)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@unique([deviceId, purpose, version])
  // Serves per-(device, purpose) version walks (current = MAX(version) … the
  // listVersions / write / getCurrentSealed read paths all scope by purpose).
  @@index([deviceId, purpose])
  // Serves atom lookups: the narrowest seal is one (device, purpose, kind) row.
  @@index([deviceId, purpose, kind])
  @@index([zoneId])
}
