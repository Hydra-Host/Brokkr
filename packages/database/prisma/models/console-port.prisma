enum ConsolePortType {
  DE9
  RJ45
  USB_A
  USB_C
  USB_MINI
  USB_MICRO
  OTHER
}

model ConsolePort {
  id          String           @id @default(uuid())
  name        String
  type        ConsolePortType?
  speed       Int?
  description String?

  device   Device @relation(fields: [deviceId], references: [id])
  deviceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, name])
  @@index([deviceId])
}

model ConsoleServerPort {
  id          String           @id @default(uuid())
  name        String
  type        ConsolePortType?
  speed       Int?
  description String?

  device   Device @relation(fields: [deviceId], references: [id])
  deviceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, name])
  @@index([deviceId])
}
