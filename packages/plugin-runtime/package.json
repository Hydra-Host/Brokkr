{
  "name": "@hydrahost/plugin-runtime",
  "version": "0.1.0",
  "description": "Host-side runtime for Brokkr plugins: SQL migration runner and NestJS bootstrap module. Installed by the host application; plugin authors should depend on @hydrahost/plugin-sdk instead.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hydrahost/plugin-sdk": "workspace:*",
    "pg": "^8.17.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11",
    "@ts-rest/core": ">=3.51"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.11",
    "@repo/typescript-config": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
