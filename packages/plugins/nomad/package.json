{
  "name": "@hydrahost/plugin-nomad",
  "version": "0.1.0",
  "description": "Brokkr plugin that drives a customer-supplied Nomad cluster (validate / plan / submit / status for Brokkr-oriented jobs). Opt-in; disabled by default until configured.",
  "license": "Apache-2.0",
  "private": true,
  "main": "./dist/cjs/plugin.js",
  "types": "./plugin.ts",
  "exports": {
    ".": {
      "types": "./plugin.ts",
      "require": "./dist/cjs/plugin.js",
      "import": "./dist/cjs/plugin.js"
    },
    "./backend": {
      "types": "./backend/index.ts",
      "require": "./dist/cjs/backend/index.js",
      "import": "./dist/cjs/backend/index.js"
    },
    "./contract": {
      "types": "./contract.ts",
      "require": "./dist/cjs/contract.js",
      "import": "./dist/cjs/contract.js"
    }
  },
  "files": [
    "dist",
    "plugin.ts",
    "contract.ts",
    "schemas.ts",
    "backend",
    "jobspecs",
    "scripts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "smoke": "bash ./scripts/smoke.sh"
  },
  "dependencies": {
    "@hydrahost/plugin-sdk": "workspace:*",
    "undici": "^7.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11",
    "@ts-rest/core": ">=3.51",
    "@ts-rest/nest": ">=3.51"
  },
  "devDependencies": {
    "@hydrahost/plugin-runtime": "workspace:*",
    "@nestjs/common": "^11.1.11",
    "@nestjs/testing": "^11.1.11",
    "@repo/typescript-config": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "@ts-rest/nest": "^3.51.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
