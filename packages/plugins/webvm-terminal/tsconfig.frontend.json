{
  "extends": "@repo/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist/esm",
    "rootDir": ".",
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./dist/esm/tsconfig.frontend.tsbuildinfo",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["plugin-frontend.ts", "server-config.ts", "frontend/**/*.ts", "frontend/**/*.tsx", "frontend/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "frontend/__test__"]
}
