{
  "name": "@hydrahost/plugin-webvm-terminal",
  "version": "0.1.0",
  "description": "Browser Linux terminal (WebVM/CheerpX) plugin. Adds a sidebar entry that opens a Debian VM running entirely in the browser in a popup window. The popup document is the only page served with COOP/COEP (cross-origin isolation for SharedArrayBuffer), so the main app, including payment iframes, is unaffected.",
  "license": "Apache-2.0",
  "main": "./dist/cjs/plugin.js",
  "types": "./plugin.ts",
  "exports": {
    ".": {
      "types": "./plugin.ts",
      "require": "./dist/cjs/plugin.js",
      "import": "./dist/cjs/plugin.js"
    },
    "./frontend": {
      "types": "./frontend/index.ts",
      "import": "./dist/esm/frontend/index.js"
    },
    "./terminal": {
      "types": "./frontend/terminal.ts",
      "import": "./dist/esm/frontend/terminal.js"
    },
    "./frontend-manifest": {
      "types": "./plugin-frontend.ts",
      "import": "./dist/esm/plugin-frontend.js"
    },
    "./server": {
      "types": "./server-config.ts",
      "require": "./dist/cjs/server-config.js",
      "import": "./server-config.ts"
    }
  },
  "files": [
    "dist",
    "plugin.ts",
    "plugin-frontend.ts",
    "server-config.ts",
    "frontend"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hydrahost/plugin-sdk": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
