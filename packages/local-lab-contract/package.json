{
  "name": "@repo/local-lab-contract",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ts-rest/core": "^3.51.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.3",
    "typescript": "^5.5.4",
    "vitest": "^4.0.17"
  }
}
