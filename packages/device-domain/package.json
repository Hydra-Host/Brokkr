{
  "name": "@repo/device-domain",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/device-spec-columns.fixture.ts",
      "require": "./dist/device-spec-columns.fixture.js",
      "import": "./src/device-spec-columns.fixture.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@repo/active-record": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/layers": "workspace:*",
    "@repo/utils": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
