@@ -60,6 +60,8 @@
 #include <netinet/ether.h>
 #elif defined(HAVE_SYS_ETHERNET_H)
 #include <sys/ethernet.h>
+#elif defined(__APPLE__)
+#include <net/ethernet.h>
 #else
 #error "either netinet/ether.h or sys/ethernet.h must exist."
 #endif
@@ -67,9 +69,29 @@
 #include <string.h>
 #include <errno.h>
 #include <stdio.h>
-#include <malloc.h>
 #include <stdlib.h>
 
+#ifdef __APPLE__
+/* macOS provides only the non-reentrant ether_aton/ether_ntoa; shim the _r
+ * variants the lanserv code uses on top of them. */
+static inline struct ether_addr *ether_aton_r(const char *s, struct ether_addr *addr)
+{
+    struct ether_addr *r = ether_aton(s);
+    if (!r)
+	return NULL;
+    *addr = *r;
+    return addr;
+}
+static inline char *ether_ntoa_r(const struct ether_addr *addr, char *buf)
+{
+    char *r = ether_ntoa(addr);
+    if (!r)
+	return NULL;
+    strcpy(buf, r);
+    return buf;
+}
+#endif
+
 #include <OpenIPMI/serv.h>
 #include <OpenIPMI/extcmd.h>
 
diff --git a/lanserv/macos_sem_compat.h b/lanserv/macos_sem_compat.h
new file mode 100644
index 00000000..36b1b288
--- /dev/null
+++ b/lanserv/macos_sem_compat.h
@@ -0,0 +1,72 @@
+/*
+ * macos_sem_compat.h — POSIX unnamed-semaphore shim for macOS.
+ *
+ * macOS does not implement POSIX unnamed semaphores: sem_init() fails at
+ * runtime with ENOSYS, and sem_timedwait() is not provided at all (link
+ * error). lanserv uses an unnamed binary semaphore per FRU (bmc_storage.c),
+ * so emulate the small subset it needs with GCD dispatch semaphores, which
+ * are native, support an absolute-time wait, and need no extra linkage.
+ *
+ * Semantics match the POSIX functions (return 0 on success, -1 + errno on
+ * failure) so the calling code behaves identically to the Linux build.
+ */
+#ifndef MACOS_SEM_COMPAT_H
+#define MACOS_SEM_COMPAT_H
+
+#include <dispatch/dispatch.h>
+#include <errno.h>
+#include <time.h>
+
+typedef dispatch_semaphore_t sem_t;
+
+static inline int sem_init(sem_t *s, int pshared, unsigned int value)
+{
+    (void) pshared; /* no cross-process support — lanserv only needs in-process */
+    *s = dispatch_semaphore_create(value);
+    if (!*s) {
+	errno = ENOMEM;
+	return -1;
+    }
+    return 0;
+}
+
+static inline int sem_destroy(sem_t *s)
+{
+    if (*s)
+	dispatch_release(*s);
+    *s = NULL;
+    return 0;
+}
+
+static inline int sem_wait(sem_t *s)
+{
+    dispatch_semaphore_wait(*s, DISPATCH_TIME_FOREVER);
+    return 0;
+}
+
+static inline int sem_post(sem_t *s)
+{
+    dispatch_semaphore_signal(*s);
+    return 0;
+}
+
+static inline int sem_trywait(sem_t *s)
+{
+    if (dispatch_semaphore_wait(*s, DISPATCH_TIME_NOW) != 0) {
+	errno = EAGAIN;
+	return -1;
+    }
+    return 0;
+}
+
+static inline int sem_timedwait(sem_t *s, const struct timespec *abs_timeout)
+{
+    dispatch_time_t t = dispatch_walltime(abs_timeout, 0);
+    if (dispatch_semaphore_wait(*s, t) != 0) {
+	errno = ETIMEDOUT;
+	return -1;
+    }
+    return 0;
+}
+
+#endif /* MACOS_SEM_COMPAT_H */
